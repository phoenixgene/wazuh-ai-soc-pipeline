jsCode	'const alert = $json.body || $json;\n\n// Extract raw telemetry\nlet rawData = {\n  alert_id: alert.id || "WZ-" + Math.floor(1000 + Math.random() * 9000),\n  agent_name: alert.agent?.name || "UNKNOWN-AGENT",\n  agent_ip: alert.agent?.ip || "0.0.0.0",\n  timestamp: alert.timestamp || new Date().toISOString(),\n  file_path: alert.data?.virustotal?.source?.file || alert.syscheck?.path || "UNKNOWN",\n  sha256: alert.data?.virustotal?.source?.sha256 || alert.syscheck?.sha256_after || "UNKNOWN",\n  positives: alert.data?.virustotal?.positives || 0,\n  total_engines: alert.data?.virustotal?.total || 0,\n  rule_description: alert.rule?.description || "No description"\n};\n\n// Enterprise Data Redaction Engine\nlet serialized = JSON.stringify(rawData);\n\n// Redact RFC 1918 internal subnets (10.x.x.x, 172.16-31.x.x, 192.168.x.x)\nserialized = serialized.replace(/\\b(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2[0-9]|3[0-1])\\.\\d{1,3}\\.\\d{1,3})\\b/g, "[INTERNAL_IP_MASKED]");\n\n// Redact Windows user profile paths\nserialized = serialized.replace(/C:\\\\\\\\Users\\\\\\\\[^\\\\]+/gi, "C:\\\\\\\\Users\\\\\\\\[CORP_USER_REDACTED]");\n\nreturn [{ json: JSON.parse(serialized) }];'
