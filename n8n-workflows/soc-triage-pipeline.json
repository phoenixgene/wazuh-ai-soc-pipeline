jsCode	`const geminiParts = $json.content.parts;\nlet fullText = "";\nfor (const part of geminiParts) {\n  if (part.text) fullText += part.text;\n}\n\nif (fullText.length > 1900) {\n  fullText = fullText.substring(0, 1900) + "\\n\\n*(truncated)*";\n}\n\nconst redactedData = $('Code in JavaScript1').item.json;\n\nconst discordPayload = {\n  content: fullText,\n  components: [\n    {\n      type: 1,\n      components: [\n        {\n          type: 2,\n          style: 4,\n          label: "Isolate Host",\n          custom_id: "isolate_" + redactedData.agent_name\n        },\n        {\n          type: 2,\n          style: 2,\n          label: "Review Quarantined Artifact",\n          custom_id: "quarantine_" + redactedData.alert_id\n        },\n        {\n          type: 2,\n          style: 3,\n          label: "Close Incident",\n          custom_id: "close_" + redactedData.alert_id\n        }\n      ]\n    }\n  ]\n};\n\nreturn [{ json: discordPayload }];`
