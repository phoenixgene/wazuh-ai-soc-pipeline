jsCode	"const staticData = $getWorkflowStaticData('global');\nstaticData.hashCache = staticData.hashCache || {};\n\nconst hash = $json.sha256;\nconst now = Date.now();\nconst CACHE_TTL = 7 * 24 * 60 * 60 * 1000; // 7 days in milliseconds\n\nif (staticData.hashCache[hash] && (now - staticData.hashCache[hash].timestamp < CACHE_TTL)) {\n  $json.cache_hit = true;\n} else {\n  $json.cache_hit = false;\n  staticData.hashCache[hash] = {\n    timestamp: now\n  };\n}\n\nreturn [{ json: $json }];"
